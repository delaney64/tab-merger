{
  "manifest_version": 3,
  "name": "Tab Merger",
  "version": "1.0",
  "description": "Merge all Chrome windows into one",
  "permissions": ["tabs", "windows"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Merge All Tabs",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
